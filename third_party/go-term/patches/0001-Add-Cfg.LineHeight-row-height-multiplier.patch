--- a/term/widget_draw.go
+++ b/term/widget_draw.go
@@ -233,7 +233,8 @@ func (t *Term) onDraw(dc *gui.DrawContext) {
 	style := t.style()
 	if t.cellW == 0 {
 		t.cellW = dc.TextWidth("M", style)
-		t.cellH = dc.FontHeight(style)
+		t.glyphH = dc.FontHeight(style)
+		t.cellH = t.glyphH * effectiveLineHeight(t.cfg.LineHeight)
 	}
 	if !finite(t.cellW) || !finite(t.cellH) {
 		return
@@ -246,6 +247,7 @@ func (t *Term) onDraw(dc *gui.DrawContext) {
 	if s := dc.Scale; s > 0 && realNumber(s) {
 		t.draw.pxScale = s
 	}
+	t.textDY = t.snapPx((t.cellH - t.glyphHeight()) / 2)
 	cols := clampDim(int(dc.Width / t.cellW))
 	rows := clampDim(int(dc.Height / t.cellH))
 	// One row of text, worst-case UTF-8; no-op when cap sufficient.
