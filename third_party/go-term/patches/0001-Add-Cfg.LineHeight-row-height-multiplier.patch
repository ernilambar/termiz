diff --git a/term/settings.go b/term/settings.go
index aa3fb74..2b15bbb 100644
--- a/term/settings.go
+++ b/term/settings.go
@@ -150,6 +150,38 @@ func (t *Term) SetScrollbarWidth(px float32) {
 	t.queueCommand(func(w *gui.Window) { w.InvalidateLayout() })
 }
 
+// MaxLineHeight is the largest Cfg.LineHeight honoured.
+const MaxLineHeight = 2
+
+// effectiveLineHeight maps Cfg.LineHeight to the multiplier applied to the
+// font height: anything non-finite or outside [1, MaxLineHeight] is 1.
+func effectiveLineHeight(v float32) float32 {
+	if !realNumber(v) || v < 1 || v > MaxLineHeight {
+		return 1
+	}
+	return v
+}
+
+// glyphHeight is the font's own line height. It falls back to cellH when
+// glyphH was never measured, so a Term built with only cellH set keeps
+// LineHeight 1 geometry.
+func (t *Term) glyphHeight() float32 {
+	if t.glyphH > 0 {
+		return t.glyphH
+	}
+	return t.cellH
+}
+
+// SetLineHeight changes the row-height multiplier, mirroring Cfg.LineHeight,
+// and forces a remeasure. Main-thread only.
+func (t *Term) SetLineHeight(v float32) {
+	if !realNumber(v) || t.cfg.LineHeight == v {
+		return
+	}
+	t.cfg.LineHeight = v
+	t.invalidateFontMetrics()
+}
+
 // SetCursorStyle changes the shape the cursor is drawn in, mirroring
 // Cfg.CursorStyle: it sets both the live shape and the default `reset`
 // restores. An unrecognized value falls back to a block.
diff --git a/term/widget_cfg.go b/term/widget_cfg.go
index afc2140..1436aea 100644
--- a/term/widget_cfg.go
+++ b/term/widget_cfg.go
@@ -203,6 +203,13 @@ type Cfg struct {
 	// Zero (default) uses the built-in 4 px. Negative hides the scrollbar.
 	ScrollbarWidth float32
 
+	// LineHeight scales the row height relative to the font's own line
+	// height. Zero (default) or anything outside [1, MaxLineHeight] means
+	// 1.0. Glyphs are centred vertically in the taller row. Box-drawing
+	// characters are font glyphs, so values above 1 leave gaps between
+	// vertically adjacent ones.
+	LineHeight float32
+
 	// NotifyAfter fires a desktop notification when a command that ran at
 	// least this long finishes while the user is looking elsewhere — the
 	// window is in the background, or (under a pane manager) this pane is not
